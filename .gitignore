# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing and verification output (screenshots of the new site, diff reports)
/coverage
/test-results/
/playwright-report/

# the local development database (PGlite, used while DATABASE_URL is empty)
/.data/

# environment variables: never commit secrets (.env.example is the only exception)
.env*
!.env.example

# Vercel
.vercel

# Sanity
.sanity/

# logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.pem

# Python (audit scripts)
__pycache__/
*.pyc

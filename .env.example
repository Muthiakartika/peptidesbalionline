# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# ── Site ───────────────────────────────────────────────────────────────
# "production" ONLY on the live domain. Any other value (or empty) = noindex everywhere.
SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Outside production the Tawk.to chat is off (visits would show in the owner's Tawk dashboard).
# "true" shows it anyway (with the owner's own chat button), e.g. to check it on a local or staging
# site. Analytics stay off. Read when the site is built: run `npm run build` again after changing it.
ENABLE_LIVE_CHAT=false
# Another Tawk.to property instead of the live chat, e.g. a test property for local/staging, so test
# chats don't reach the inbox of real customers (src/lib/tawk.ts). Both from the widget code's address
# https://embed.tawk.to/<property ID>/<widget ID>. Not secrets. Set both or neither; leave both
# EMPTY on the live domain (empty = the owner's live chat).
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# ── Sanity (CMS) ───────────────────────────────────────────────────────
# From https://www.sanity.io/manage → your project. Project ID and dataset are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only token with write access, used by migration scripts (Phase 4). Keep secret.
SANITY_API_WRITE_TOKEN=
# "sanity" = pages, shared sections, popups and the product-page block come from Sanity (the dataset
# above); empty = from the copies in src/content/. See docs/content/editing-in-sanity.md.
CONTENT_SOURCE=
# Sanity → API → Webhooks: the secret of the webhook that calls /api/sanity/revalidate on publish.
# A long random value. Keep secret.
SANITY_REVALIDATE_SECRET=

# ── Pictures: Cloudflare R2 (docs/setup/r2.md) ─────────────────────────
# Cloudflare → R2 → the account ID, an API token's access key + secret (Object Read & Write on the
# bucket), the bucket's name and its public address. The key and secret are secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Set to the same public address ONLY after scripts/media/copy-uploads-to-r2.mjs has copied every
# picture: from then on the site shows pictures from the bucket instead of WordPress. Rebuild after
# changing it (NEXT_PUBLIC_ values are written into the build).
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── PostgreSQL (Neon or Supabase) ──────────────────────────────────────
# Neon: Connect → the "Pooled connection" string, for the site. Keep secret.
# Empty on your computer = a local development database in .data/pglite (run `npm run db:migrate` once,
# with the site stopped). Production (SITE_ENV=production) needs a real URL.
DATABASE_URL=
# Neon: the same string with pooling switched off (direct), for `npm run db:migrate`. Keep secret.
# Empty = migrations use DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# Signs the login cookies. A long random value, different for every environment (local, staging,
# live). Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Added in later phases (names reserved, do not fill yet):
# RECAPTCHA_SECRET_KEY=          Phase 5/6, a NEW key, never the one from WordPress
# EMAIL_PROVIDER_API_KEY=        Phase 5, after Q-08
# PAYMENT_*                      Phase 5, sandbox keys only until providers approve (Q-01, Q-02)

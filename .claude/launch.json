{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-staging",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "NEXT_PUBLIC_SANITY_DATASET": "staging"
      },
      "port": 3000
    },
    {
      "name": "dev-sanity-staging",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "NEXT_PUBLIC_SANITY_DATASET": "staging",
        "CONTENT_SOURCE": "sanity"
      },
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "dev-local-db",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3007"
      ],
      "env": {
        "DATABASE_URL": "",
        "DATABASE_URL_UNPOOLED": "",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3007",
        "ENABLE_LIVE_CHAT": "false"
      },
      "port": 3007
    },
    {
      "name": "prod-local-db",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev/start-local-db.mjs"
      ],
      "port": 3006
    }
  ]
}